# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for Drizzle (use the Supabase "Session" pooler URL for app code,
# "Transaction" pooler for serverless functions, and the direct URL for migrations).
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Used by `scripts/bootstrap-admin.ts` and the manual SQL promotion step.
# Set to the email you'll use to log in — after first sign-in, this row is promoted to admin.
ADMIN_BOOTSTRAP_EMAIL=

# ============================================================================
# Razorpay (Standard Checkout — one-time orders)
# ============================================================================
# Server-only — from Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Exposed to the browser (Checkout needs the key id). Must equal RAZORPAY_KEY_ID.
# NEVER put the secret in any NEXT_PUBLIC_* var.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Webhook signing secret — Razorpay Dashboard → Settings → Webhooks (set when you
# create the webhook pointing at /api/razorpay/webhook). Distinct from the key secret.
RAZORPAY_WEBHOOK_SECRET=

# ============================================================================
# Google Meet (keyless: Vercel OIDC -> GCP WIF -> domain-wide delegation)
# ============================================================================
# No service-account JSON key (the org enforces iam.disableServiceAccountKeyCreation).
# All three GOOGLE_* below are NON-SECRET but INTEGRITY-SENSITIVE: restrict who
# can edit them in Vercel; prefer Production scope only unless preview Meet is
# needed with its own pinned principal. See README "Google Meet (keyless)".
# Full WIF provider resource name (NOTE: project NUMBER, not the project id):
GOOGLE_WORKLOAD_IDENTITY_PROVIDER=//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID
# SA the federated identity impersonates; its client id must be DWD-authorized in Workspace:
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=meet-signer@your-project.iam.gserviceaccount.com
# Workspace mailbox whose calendar hosts the Meet events (the DWD `sub`):
GOOGLE_IMPERSONATE_SUBJECT=hello@yourdomain.com
# Calendar that hosts session events. With impersonation, `primary` = the
# subject's Workspace calendar (Meet-capable). Or set a dedicated bookings calendar id.
GOOGLE_SYSTEM_CALENDAR_ID=primary
# VERCEL_OIDC_TOKEN is injected automatically by Vercel at runtime; locally run
# `vercel env pull` then `vercel dev`. Do not paste a value here.

# ============================================================================
# Resend (transactional email)
# ============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL="My Yoga Classes <hello@myyogaclasses.fit>"

# ============================================================================
# Auth: passwordless email OTP (configured INSIDE Supabase Auth, no env vars here)
# ============================================================================
# Login uses Google OAuth + email one-time passcode. For the inline code flow
# the Supabase "Magic Link" email template must include {{ .Token }}; otherwise
# Supabase sends a magic link instead of a code. Phone/SMS auth is no longer used.
#
# IMPORTANT: auth emails (the OTP/magic link) are sent by SUPABASE, not by the
# RESEND_API_KEY above — that key only powers transactional app email. Supabase's
# built-in sender is throttled (a few/hour) and causes "email rate limit exceeded"
# in production. Fix in the Supabase dashboard, not here: Authentication → Emails →
# SMTP Settings → custom SMTP (smtp.resend.com:465, user "resend", pass = your
# Resend API key, verified From), then raise Auth → Rate Limits for email.

# ============================================================================
# Analytics
# ============================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SERVER_KEY=

# ============================================================================
# Sentry
# ============================================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============================================================================
# WhatsApp (floating "chat with us" button)
# ============================================================================
# Full international number, digits only — no "+", spaces or dashes.
# e.g. 61412345678 (AU) or 919812345678 (IN). Leave blank to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ============================================================================
# Site
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Registered ABN, shown in the footer. Leave blank to hide it until registered.
NEXT_PUBLIC_ABN=

# ============================================================================
# Cron / scheduled jobs (app/api/cron/*)
# ============================================================================
# Shared secret required in the `Authorization: Bearer <CRON_SECRET>` header on
# every /api/cron/* request. Generate with `openssl rand -hex 32`. Schedule the
# endpoints from your host's cron, an external scheduler, or Supabase pg_cron:
#   /api/cron/meet-retry      every 15-30 min
#   /api/cron/reminders       every 15 min
#   /api/cron/no-show-sweep   hourly
#   /api/cron/paypal-reconcile daily   (currently a stub)
CRON_SECRET=
